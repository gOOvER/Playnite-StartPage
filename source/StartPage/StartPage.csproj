<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{4FDF1E89-5BC3-4C72-8FDA-0D580E7A5D5F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>LandingPage</RootNamespace>
    <AssemblyName>StartPagePlugin</AssemblyName>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Suppress NuGet audit warning for Newtonsoft.Json 10.0.3 which is required by Playnite runtime host -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Localization files must be Content (copied to output), not compiled XAML Pages -->
  <ItemGroup>
    <Page Remove="Localization\**" />
    <Content Include="Localization\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embedded Resources for controls and rating -->
  <ItemGroup>
    <Resource Include="transparent_noise.png" />
    <Resource Include="white_noise.png" />
    <Resource Include="noise.png" />
    <Resource Include="innerglow.png" />
    <Resource Include="dark_noise.png" />
    <Resource Include="empty.png" />
    <Resource Include="star.png" />
  </ItemGroup>

  <!-- Files copied to output directory -->
  <ItemGroup>
    <Content Include="DefaultLayout.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="PlaceholderCover.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\extern\PlayniteCommon\PlayniteCommon.csproj" />
    <ProjectReference Include="..\StartPage.SDK\StartPage.SDK.csproj" />
    <ProjectReference Include="..\StartPage.SDK.Async\StartPage.SDK.Async.csproj" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Gu.Wpf.NumericInput" Version="0.5.5" />
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="PlayniteSDK" Version="6.18.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SqlNado" Version="2.1.0" />
  </ItemGroup>

  <Target Name="PackOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and Exists('$(LOCALAPPDATA)\Playnite\Toolbox.exe')">
    <Exec Command="&quot;$(LOCALAPPDATA)\Playnite\Toolbox.exe&quot; pack &quot;$(TargetDir.TrimEnd('\'))&quot; &quot;$(ProjectDir)bin&quot;" />
  </Target>
</Project>